# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL (auth email redirects, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Usernames allowed to open /admin (comma-separated).
# This only hides the UI. Protect data with Supabase RLS / RPCs.
NEXT_PUBLIC_ADMIN_USERNAMES=admin

# Optional: Umami Cloud website id
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
